{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MY C++ BUILD",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-c",
                "mkdir -p '${fileDirname}/build' && /usr/bin/g++ -g '${file}' -o '${fileDirname}/build/${fileBasenameNoExtension}'"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "C/C++: g++-15 build active file",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-c",
                "mkdir -p '${fileDirname}/build' && /usr/local/bin/g++-15 -fdiagnostics-color=always -g '${file}' -o '${fileDirname}/build/${fileBasenameNoExtension}'"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "C/C++: clang++ build active file",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-c",
                "mkdir -p '${fileDirname}/build' && /usr/bin/clang++ -fcolor-diagnostics -fansi-escape-codes -g '${file}' -o '${fileDirname}/build/${fileBasenameNoExtension}'"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "C/C++: g++ build active file",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-c",
                "mkdir -p '${fileDirname}/build' && /usr/bin/g++ -fdiagnostics-color=always -g '${file}' -o '${fileDirname}/build/${fileBasenameNoExtension}'"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}